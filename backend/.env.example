# Runtime
ENVIRONMENT=development

# LLM (leave OPENAI_API_KEY empty for corpus-only fallback)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=45
OPENAI_MAX_RETRIES=2

# RAG prompt budget
RAG_CONTEXT_MAX_CHARS=30000

# Production protection
RATE_LIMIT_PER_MINUTE=12
MAX_BODY_BYTES=1000000
ALLOWED_HOSTS=astromyla.onrender.com
EXPOSE_DEBUG_DATA=false

# Optional comma-separated override for production CORS origins.
# If empty, the API allows astromyla.com, www.astromyla.com,
# and the Render frontend subdomain used by this project.
CORS_ORIGINS=

# Optional Swiss Ephemeris data directory. Chiron requires asteroid ephemeris
# files; if they are absent the API reports Chiron as unavailable rather than
# fabricating a position.
SE_EPHE_PATH=

# Premium report fulfillment (server-side only; never expose in Vite/frontend env)
# Use a long random value in Render. Payment webhooks/admin fulfillment can call
# POST /api/premium/natal-report with X-Premium-Token.
PREMIUM_REPORT_TOKEN=
# Optional separate model for paid long-form reports. Falls back to OPENAI_MODEL.
OPENAI_PREMIUM_MODEL=

# v1.7 secure iyzico hosted checkout (server-side only)
# Keep these ONLY in Render backend Environment. Never prefix with VITE_.
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
PAID_READING_PRICE_TRY=
DEEP_READING_PRICE_TRY=
DATABASE_URL=
PUBLIC_API_BASE_URL=https://astromyla.onrender.com
PUBLIC_SITE_URL=https://astromyla.com
